# Copy to testflight.env (git-ignored). scripts/testflight.sh then uploads with this
# App Store Connect API key instead of Xcode's account sign-in.
# Create one at App Store Connect → Users and Access → Integrations (Admin role: App Store signing uses cloud-managed certificates, which need it).
ASC_KEY_PATH=$HOME/.appstoreconnect/AuthKey_XXXXXXXXXX.p8
ASC_KEY_ID=XXXXXXXXXX
# Only for team keys; individual keys have no issuer ID.
ASC_ISSUER_ID=
# Optional: the App Review contact that scripts/appstore.rb fills in. Phone with country code.
REVIEW_FIRST_NAME=
REVIEW_LAST_NAME=
REVIEW_EMAIL=
REVIEW_PHONE=+44
